{
  "name": "chess-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-tests.mjs --unit",
    "test:integration": "node scripts/run-tests.mjs --integration",
    "test:e2e": "node scripts/run-tests.mjs --e2e",
    "test:live": "node scripts/run-tests.mjs --live",
    "test:all": "node scripts/run-tests.mjs --all",
    "test:watch": "vitest",
    "test:extension": "node scripts/test-extension.mjs",
    "extension:icons": "node scripts/build-extension-icons.mjs",
    "extension:build": "node scripts/build-extension-icons.mjs && node scripts/build-extension.mjs"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.6",
    "@supabase/supabase-js": "^2.105.3",
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "dexie": "^4.4.2",
    "dexie-export-import": "^4.4.0",
    "dexie-react-hooks": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.13.0",
    "stockfish": "^16.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.59.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
